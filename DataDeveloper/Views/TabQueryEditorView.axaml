<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:avaloniaEdit="https://github.com/avaloniaui/avaloniaedit"
             xmlns:viewModels="clr-namespace:DataDeveloper.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="DataDeveloper.Views.TabQueryEditorView"
             xmlns:vm="using:DataDeveloper.ViewModels"
             xmlns:dock="using:Dock.Avalonia.Controls"
             xmlns:dockModel="using:Dock.Model.Avalonia.Controls"
             xmlns:dockCore="using:Dock.Model.Core"
             xmlns:docking="clr-namespace:DataDeveloper.Docking"
             xmlns:templateSelectors="clr-namespace:DataDeveloper.TemplateSelectors"
             x:DataType="vm:TabQueryEditorViewModel"
             x:Name="QueryEditorRoot"
             >
    <Design.DataContext>
        <viewModels:TabQueryEditorViewModel />
    </Design.DataContext>
    <UserControl.KeyBindings>
        <KeyBinding Gesture="F5" Command="{Binding ExecuteCommand}" ></KeyBinding>
    </UserControl.KeyBindings>
    <UserControl.Styles>
        <!-- Result tabs (not Message) get a close button; Dock's tool tabs have none. -->
        <Style Selector="dock|ToolControl">
            <Setter Property="HeaderTemplate">
                <DataTemplate DataType="dockCore:IDockable">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{Binding Title}"
                                   VerticalAlignment="Center"
                                   Padding="{DynamicResource DockHeaderContentPadding}" />
                        <Button Background="Transparent"
                                Padding="0"
                                VerticalAlignment="Center"
                                IsVisible="{Binding CanClose}"
                                Click="OnResultTabCloseClick">
                            <TextBlock Text="&#xF0156;" Classes="MaterialIcon" FontSize="12" />
                        </Button>
                    </StackPanel>
                </DataTemplate>
            </Setter>
        </Style>
    </UserControl.Styles>
    <UserControl.Resources>
        <templateSelectors:TabTemplateSelector x:Key="ResultTemplateSelector" />
        <docking:ConnectionDockItemContainerGenerator x:Key="ResultItemGenerator" />
    </UserControl.Resources>
    <Panel x:Name="EditorHost">
    <!-- Toolbar, editor and status bar; moved into the EditorPane document by the code-behind. -->
    <Grid x:Name="RootGrid" Background="#3C3F41" DataContext="{Binding #QueryEditorRoot.DataContext}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="{Binding EditorHeadHeight}" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel x:Name="StackPanelEditor" Grid.Row="0" Margin="4" Background="#3C3F41" Orientation="Horizontal">
            <TextBlock Text="Statement timeout:"
                       Margin="0,0,6,0"
                       VerticalAlignment="Center"
                       Foreground="LightGray"
                       FontSize="11" />
            <ComboBox Width="72"
                      Margin="0,0,8,0"
                      SelectedItem="{Binding SelectedRunTimeoutSeconds, Mode=TwoWay}"
                      ItemsSource="{Binding RunTimeoutOptions}"
                      VerticalAlignment="Center"
                      FontSize="11"
                      FontFamily="{StaticResource MonospaceFont}" />
            <Button Background="Transparent" Command="{Binding ExecuteCommand}" IsEnabled="{Binding !StatementIsRunning}" ToolTip.Tip="F5 - Run the statement" >
                <TextBlock Classes="MaterialIcon" Text="&#xF040A;" Foreground="{Binding !StatementIsRunning, Converter={StaticResource BoolToColor}, ConverterParameter='Green|Gray'}" Background="Transparent"></TextBlock>
            </Button>
            <Button Background="Transparent" Command="{Binding StopCommand}" IsEnabled="{Binding StatementIsRunning}" ToolTip.Tip="Ctrl+F5 - Stop the execution of the statement">
                <TextBlock Classes="MaterialIcon" Text="&#xF04DB;" Foreground="{Binding StatementIsRunning, Converter={StaticResource BoolToColor}, ConverterParameter='Firebrick|Gray'}" Background="Transparent"></TextBlock>
            </Button>
            <Border Width="1"
                    Height="16"
                    Background="LightGray"
                    Opacity="0.5"
                    VerticalAlignment="Center"
                    Margin="6,0" />
            <Button Background="Transparent" Command="{Binding CommitTransactionCommand}" ToolTip.Tip="Commit pending transaction">
                <TextBlock Classes="MaterialIcon" Text="&#xF012C;" Foreground="{Binding HasActiveTransaction, Converter={StaticResource BoolToColor}, ConverterParameter='Green|Gray'}" Background="Transparent"></TextBlock>
            </Button>
            <Button Background="Transparent" Command="{Binding RollbackTransactionCommand}" ToolTip.Tip="Rollback pending transaction">
                <TextBlock Classes="MaterialIcon" Text="&#xF054C;" Foreground="{Binding HasActiveTransaction, Converter={StaticResource BoolToColor}, ConverterParameter='Firebrick|Gray'}" Background="Transparent"></TextBlock>
            </Button>
            <TextBlock Text="{Binding TransactionStatusMessage}"
                       Margin="6,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="{Binding HasActiveTransaction, Converter={StaticResource BoolToColor}, ConverterParameter='LightGreen|LightGray'}"
                       FontSize="11"
                       FontFamily="{StaticResource MonospaceFont}" />
        </StackPanel>
        <Grid x:Name="EditorLayoutGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="0" />
                <ColumnDefinition Width="0" MinWidth="0" />
            </Grid.ColumnDefinitions>
            <avaloniaEdit:TextEditor 
                Grid.Column="0"
                x:Name="SqlEditor"
                FontFamily="{StaticResource MonospaceFont}"
                ShowLineNumbers="True"
                SyntaxHighlighting="SQL"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Visible"
                Background="#202424"
                Text="select * from payment"
            />
            <GridSplitter Grid.Column="1"
                          Width="5"
                          ResizeDirection="Columns"
                          IsVisible="{Binding HasDetectedParameters}" />
            <Border Grid.Column="2"
                IsVisible="{Binding HasDetectedParameters}"
                Background="#2B2B2B"
                BorderBrush="#4A4A4A"
                BorderThickness="1,0,0,0"
                HorizontalAlignment="Stretch">
            <Grid RowDefinitions="Auto,Auto,*" IsSharedSizeScope="True">
                <TextBlock Text="Parameters"
                           Margin="10,10,10,6"
                           FontWeight="SemiBold"
                           Foreground="White" />
                <Grid Grid.Row="1" Margin="10,0,10,6" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition SharedSizeGroup="colLabel" Width="Auto" />
                        <ColumnDefinition SharedSizeGroup="colCheckBox" Width="Auto" />
                        <ColumnDefinition SharedSizeGroup="colValue" Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Name" Foreground="#BBBBBB" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Send&#10;as Null" Foreground="#BBBBBB" FontSize="11" VerticalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="Value" Foreground="#BBBBBB" FontSize="11" VerticalAlignment="Center"/>
                </Grid>
                <ScrollViewer Grid.Row="2" Margin="10,0,10,10" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ParameterValues}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition SharedSizeGroup="colLabel" Width="Auto" />
                                        <ColumnDefinition SharedSizeGroup="colCheckBox" Width="Auto" />
                                        <ColumnDefinition SharedSizeGroup="colValue" Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Name}"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource MonospaceFont}" />
                                    <CheckBox Grid.Column="1"
                                              IsChecked="{Binding IsNull, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center" />
                                    <TextBox Grid.Column="2"
                                             Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding !IsNull}"
                                             MinWidth="120"
                                             HorizontalAlignment="Stretch"
                                             PlaceholderText="null" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
        </Grid>
        <Border Grid.Row="2" BorderBrush="#4A4A4A" BorderThickness="0,1,0,0">
            <Grid x:Name="StatusBar" Margin="4,2">
                <StackPanel Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            Margin="5,0">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="11"
                               FontFamily="{StaticResource MonospaceFont}">
                        <Run Text="Cursor -> " Foreground="Gray"/>
                        <Run Text="Lin:" Foreground="Gray"/>
                        <Run Text="{Binding CursorLine}" />
                        <Run Text=" Col:" Foreground="Gray"/>
                        <Run Text="{Binding CursorColumn}" />
                        <Run Text=" Offset:" Foreground="Gray"/>
                        <Run Text="{Binding CursorOffSet}" />
                    </TextBlock>
                    <Border Width="1"
                            Height="14"
                            Background="LightGray"
                            Opacity="0.5"
                            VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ExecutionStatusMessage}"
                               IsVisible="{Binding IsExecutionStatusVisible}"
                               Foreground="LightGray"
                               FontSize="11"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource MonospaceFont}" />
                    <ProgressBar Width="80"
                                 Height="8"
                                 IsIndeterminate="True"
                                 IsVisible="{Binding IsExecutionStatusVisible}"
                                 VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

    <!-- The editor above its Results tool dock: Message and result tabs are Dock tools that can be pinned
         (collapsed to the bottom rail) as a group, independently for each query. -->
    <dock:DockControl x:Name="QueryDock"
                      InitializeFactory="True"
                      InitializeLayout="True">
        <dock:DockControl.Factory>
            <docking:QueryDockFactory ResultsDockId="QueryResults" />
        </dock:DockControl.Factory>

        <dockModel:RootDock Id="QueryRoot"
                            IsCollapsable="False"
                            EnableGlobalDocking="False"
                            AllowedDropOperations="None"
                            DefaultDockable="{Binding #QueryLayout}"
                            ActiveDockable="{Binding #QueryLayout}">
            <dockModel:ProportionalDock x:Name="QueryLayout"
                                        Id="QueryLayout"
                                        Orientation="Vertical"
                                        AllowedDropOperations="None"
                                        ActiveDockable="{Binding #EditorPane}">
                <!-- A document outside a document dock is shown without a tab strip. -->
                <dockModel:Document x:Name="EditorPane"
                                    Id="EditorPane"
                                    CanClose="False"
                                    CanDrag="False"
                                    CanDrop="False"
                                    CanFloat="False"
                                    CanPin="False" />

                <dockModel:ProportionalDockSplitter />

                <dockModel:ToolDock x:Name="ResultsDock"
                                    Id="QueryResults"
                                    Alignment="Bottom"
                                    AllowedDropOperations="None"
                                    Proportion="0.4"
                                    ItemContainerGenerator="{StaticResource ResultItemGenerator}"
                                    ItemsSource="{Binding #QueryEditorRoot.((vm:TabQueryEditorViewModel)DataContext).Tabs}">
                    <dockModel:ToolDock.ToolTemplate>
                        <dockModel:ToolTemplate>
                            <Grid x:DataType="dockModel:Tool">
                                <ContentControl Content="{Binding Context}"
                                                ContentTemplate="{StaticResource ResultTemplateSelector}" />
                            </Grid>
                        </dockModel:ToolTemplate>
                    </dockModel:ToolDock.ToolTemplate>
                </dockModel:ToolDock>
            </dockModel:ProportionalDock>
        </dockModel:RootDock>
    </dock:DockControl>
    </Panel>
</UserControl>
