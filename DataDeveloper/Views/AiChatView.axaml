<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DataDeveloper.ViewModels"
             xmlns:models="clr-namespace:DataDeveloper.Data.Models;assembly=DataDeveloper.Data"
             mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="600"
             MinWidth="360"
             x:Class="DataDeveloper.Views.AiChatView"
             x:DataType="vm:AiChatViewModel">

    <UserControl.Styles>
        <Style Selector="Border.bubble">
            <Setter Property="Margin" Value="8,4" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="#26808080" />
        </Style>
        <Style Selector="Border.bubble.user">
            <Setter Property="Background" Value="#3A4C78C8" />
        </Style>
        <Style Selector="Border.bubble.error">
            <Setter Property="Background" Value="#40CD5C5C" />
        </Style>
        <Style Selector="Border.code">
            <Setter Property="Background" Value="#40000000" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style Selector="Button.small">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" Margin="8,6">
            <TextBlock Text="AI Assistant" FontWeight="SemiBold" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1"
                      Width="130"
                      FontSize="12"
                      IsEditable="True"
                      PlaceholderText="Model (default)"
                      ItemsSource="{Binding ModelSuggestions}"
                      Text="{Binding Model, Mode=TwoWay}"
                      ToolTip.Tip="Model for this chat. Empty uses the default from Preferences." />
            <Button Grid.Column="2" Content="Clear" Classes="small" Command="{Binding ClearCommand}" ToolTip.Tip="Delete this connection's chat history" />
        </Grid>

        <ScrollViewer Grid.Row="1" x:Name="MessagesScroller" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Margin="12" TextWrapping="Wrap" Opacity="0.65" IsVisible="{Binding !HasMessages}"
                           Text="Ask about this database, paste an error, or attach a file, a query or tables. Answers use the structure of the relevant tables; no row data is sent." />
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AiChatMessageViewModel">
                            <Border Classes="bubble" Classes.user="{Binding IsUser}" Classes.error="{Binding IsError}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding Author}" FontSize="11" Opacity="0.7" />
                                    <ItemsControl ItemsSource="{Binding Segments}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:AiMessageSegmentViewModel">
                                                <Grid>
                                                    <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" IsVisible="{Binding IsProse}" />
                                                    <Border Classes="code" IsVisible="{Binding IsCode}">
                                                        <StackPanel>
                                                            <Grid ColumnDefinitions="*,Auto,Auto">
                                                                <TextBlock Text="{Binding Language}" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                                                                <Button Grid.Column="1" Content="Copy" Classes="small" Click="OnCopyCodeClick" />
                                                                <Button Grid.Column="2" Content="Insert in editor" Classes="small"
                                                                        IsVisible="{Binding CanInsert}"
                                                                        Command="{Binding InsertCommand}" />
                                                            </Grid>
                                                            <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                                                                 FontFamily="Menlo,Consolas,Monospace" FontSize="12" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <ProgressBar Grid.Row="2" IsIndeterminate="True" Height="3" IsVisible="{Binding IsBusy}" />

        <TextBlock Grid.Row="3" Text="{Binding StatusText}" Foreground="IndianRed" FontSize="11" Margin="10,2" TextWrapping="Wrap"
                   IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <!-- Composer: attachments, the text box and, below it, "+" (add context) and the send/stop button. -->
        <Border Grid.Row="4" Margin="8" Padding="8,6" CornerRadius="12" BorderThickness="1"
                BorderBrush="#50808080" Background="#18808080">
            <StackPanel Spacing="4">
                <ItemsControl ItemsSource="{Binding Attachments}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AiAttachmentItem">
                            <Border Background="#33808080" CornerRadius="10" Padding="8,2,2,2" Margin="0,0,4,4">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <TextBlock Text="{Binding Name}" FontSize="11" VerticalAlignment="Center" />
                                    <Button Content="x" Classes="small" Padding="4,0" Command="{Binding RemoveCommand}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBox x:Name="DraftBox"
                         Text="{Binding Draft, Mode=TwoWay}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="48" MaxHeight="150"
                         BorderThickness="0"
                         Background="Transparent"
                         Padding="2"
                         Watermark="{Binding InputHint}">
                    <TextBox.Resources>
                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                    </TextBox.Resources>
                </TextBox>

                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Button Grid.Column="0" x:Name="AddButton" Content="+" FontSize="18" Padding="10,0" Classes="small"
                            ToolTip.Tip="Add context: file, query or tables">
                        <Button.Flyout>
                            <Flyout Placement="TopEdgeAlignedLeft" Opened="OnAddFlyoutOpened">
                                <StackPanel Width="300" Spacing="2" x:DataType="vm:AiChatViewModel">
                                    <Button Content="File..." HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Classes="small" Click="OnAttachFileClick" />
                                    <TextBlock Text="Query" FontSize="11" Opacity="0.6" Margin="8,6,0,0" />
                                    <Button Content="Whole query" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Classes="small" Command="{Binding AttachWholeQueryCommand}" Click="OnAddFlyoutActionClick" />
                                    <Button Content="Selection only" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Classes="small" Command="{Binding AttachSelectionCommand}" Click="OnAddFlyoutActionClick" />
                                    <TextBlock Text="Tables and views (click to add)" FontSize="11" Opacity="0.6" Margin="8,6,0,0" />
                                    <TextBox Text="{Binding ObjectFilter, Mode=TwoWay}" Watermark="Filter..." />
                                    <ListBox x:Name="ObjectList" Height="220" SelectionMode="Single"
                                             ItemsSource="{Binding ObjectChoices}" SelectionChanged="OnObjectSelected">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:DbObjectRef">
                                                <TextBlock Text="{Binding QualifiedName}" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <!-- Idle: send (with a menu to choose Enter or Cmd/Ctrl+Enter). Busy: the same spot becomes Stop. -->
                    <SplitButton Grid.Column="2" x:Name="SendButton" Classes="primary"
                                 Command="{Binding SendCommand}"
                                 IsVisible="{Binding !IsBusy}"
                                 ToolTip.Tip="Send">
                        <TextBlock Text="&#x21B5;" FontSize="16" />
                        <SplitButton.Flyout>
                            <MenuFlyout Placement="TopEdgeAlignedRight" Opened="OnSendModeMenuOpened">
                                <MenuItem x:Name="EnterModeItem" ToggleType="Radio" GroupName="SendMode" Click="OnEnterModeClick" />
                                <MenuItem x:Name="ModifierModeItem" ToggleType="Radio" GroupName="SendMode" Click="OnModifierModeClick" />
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>
                    <Button Grid.Column="2" Command="{Binding StopCommand}" IsVisible="{Binding IsBusy}"
                            Classes="dialog-button" Padding="14,6" ToolTip.Tip="Stop">
                        <TextBlock Text="&#x25A0;" FontSize="14" />
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
