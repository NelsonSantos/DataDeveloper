<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:DataDeveloper.ViewModels"
             xmlns:controls="clr-namespace:DataDeveloper.Controls"
             xmlns:models="clr-namespace:DataDeveloper.Data.Models;assembly=DataDeveloper.Data"
             mc:Ignorable="d" d:DesignWidth="950" d:DesignHeight="550"
             x:Class="DataDeveloper.Views.ConnectionSelectorDialogView">
<!-- Bind the corresponding ViewModel -->
    <Design.DataContext>
      <viewModels:ConnectionSelectorViewModel />
    </Design.DataContext>
    <DockPanel Margin="10">

        <!-- Footer bar with action buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
            <Button Content="Test Connection"
                    Command="{Binding TestCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                    IsEnabled="{Binding SelectedConnection}"
                    Margin="0,0,20,0" />
            <Button Content="Apply" Command="{Binding ApplyCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Self}}" IsEnabled="{Binding IsEditing}" />
            <Button Content="Connect" Command="{Binding OkCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Self}}" IsEnabled="{Binding SelectedConnection}" />
            <Button Content="Cancel" Command="{Binding CancelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource Self}}" />
        </StackPanel>

        <!-- Main body: left for list, right for connection details -->
        <Grid ColumnDefinitions="2*,3*" RowDefinitions="*" >

            <Border Grid.Column="0" Margin="0,0,10,0" BorderBrush="#FF4A505C" BorderThickness="1" CornerRadius="6" Padding="10">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="8">
                    <TextBlock Grid.Row="0"
                               Text="Connections"
                               FontWeight="SemiBold"
                               FontSize="13" />

                    <TextBlock Grid.Row="1"
                               Text="Connection Types" />

                    <ComboBox Grid.Row="2"
                              HorizontalAlignment="Stretch"
                              ItemsSource="{Binding AvailableConnectionFilters}"
                              SelectedItem="{Binding SelectedConnectionFilter, Mode=TwoWay}"
                              >
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <controls:DatabaseTypeIcon Grid.Column="0"
                                                               DatabaseType="{Binding DatabaseType}"
                                                               BadgeSize="24"
                                                               IconSize="14"
                                                               BadgePadding="3"
                                                               IsVisible="{Binding HasDatabaseType}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DisplayName}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Grid.Row="3"
                               Text="Select a type to filter or to add a new connection."
                               FontSize="11"
                               Foreground="DarkGoldenrod"
                               TextWrapping="Wrap" />

                    <TreeView Grid.Row="4"
                              ItemsSource="{Binding RootNodes}"
                              SelectedItem="{Binding SelectedTreeItem, Mode=TwoWay}"
                              BorderThickness="1"
                              BorderBrush="#FF4A505C"
                              CornerRadius="3"
                              >
                        <TreeView.Styles>
                            <Style Selector="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding Group.IsExpanded, Mode=TwoWay}" />
                                <Setter Property="Padding" Value="5" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="MinHeight" Value="20" />
                            </Style>
                        </TreeView.Styles>
                        <TreeView.DataTemplates>
                            <TreeDataTemplate DataType="{x:Type models:ConnectionGroupNode}"
                                               ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="&#xF024B;" Classes="MaterialIcon" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                </StackPanel>
                            </TreeDataTemplate>
                            <TreeDataTemplate DataType="{x:Type models:ConnectionSettings}">
                                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto,*,Auto"
                                      Background="Transparent"
                                      DoubleTapped="ConnectionRow_DoubleTapped">
                                    <CheckBox Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                                              IsChecked="{Binding IsBulkSelected, Mode=TwoWay}"
                                              Click="ConnectionCheckBox_Click"
                                              VerticalAlignment="Center"
                                              Margin="0,0,5,0" />
                                    <controls:DatabaseTypeIcon Grid.Row="0"
                                                               Grid.Column="1"
                                                               Grid.RowSpan="2"
                                                               DatabaseType="{Binding DatabaseType}"
                                                               VerticalAlignment="Top" Margin="0, 0, 5, 0" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center"  />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding DatabaseType}" VerticalAlignment="Center"  FontSize="10" />
                                    <Button Grid.Row="0" Grid.Column="3" Grid.RowSpan="2"
                                            Background="Transparent" ToolTip.Tip="Edit"
                                            IsVisible="{Binding !DataContext.HasBulkSelection, RelativeSource={RelativeSource AncestorType=TreeView}}"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=TreeView}}"
                                            CommandParameter="{Binding .}"
                                            >
                                        <TextBlock Text="&#xF03EB;" Classes="MaterialIcon" />
                                    </Button>
                                </Grid>
                            </TreeDataTemplate>
                        </TreeView.DataTemplates>
                    </TreeView>

                    <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="4">
                        <Button Background="Transparent"
                                ToolTip.Tip="Duplicate"
                                Command="{Binding DuplicateConnectionCommand}"
                                IsEnabled="{Binding SelectedConnection}">
                            <TextBlock Text="&#xF018F;" Classes="MaterialIcon" />
                        </Button>
                        <Button Background="Transparent"
                                ToolTip.Tip="Add new"
                                Command="{Binding AddCommand}"
                                IsEnabled="{Binding CanAddConnection}">
                            <TextBlock Text="&#xF0415;" Classes="MaterialIcon" />
                        </Button>
                        <Button Background="Transparent"
                                ToolTip.Tip="Import"
                                Command="{Binding ImportCommand}">
                            <TextBlock Text="&#xF0120;" Classes="MaterialIcon" />
                        </Button>
                        <Button Background="Transparent"
                                ToolTip.Tip="Export"
                                Command="{Binding BulkExportCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                                IsEnabled="{Binding HasBulkSelection}">
                            <TextBlock Text="&#xF011D;" Classes="MaterialIcon" />
                        </Button>
                        <Button Background="Transparent"
                                ToolTip.Tip="Delete"
                                Command="{Binding BulkDeleteCommand}"
                                IsEnabled="{Binding HasBulkSelection}">
                            <TextBlock Text="&#xF0A7A;" Classes="MaterialIcon" Foreground="Brown" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Connection detail view -->
            <StackPanel Grid.Column="1" Spacing="8">

                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="3*,1*" ColumnSpacing="10" RowSpacing="8">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" />
                    <TextBox Grid.Row="1" Grid.Column="0" 
                        Text="{Binding SelectedConnection.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        IsEnabled="{Binding IsEditing}"
                        IsReadOnly="{Binding !IsEditing}" />

                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Database Type" />
                    <TextBox Grid.Row="1" Grid.Column="1"
                             Text="{Binding SelectedConnection.DatabaseType, Mode=TwoWay}"
                             IsEnabled="False" />
                </Grid>

                <Border BorderBrush="#FF4A505C" BorderThickness="1" CornerRadius="6" Padding="10">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Group" FontSize="11" Foreground="#BBBBBB" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <ComboBox Grid.Column="0"
                                      HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding GroupOptions}"
                                      SelectedItem="{Binding SelectedConnectionGroup, Mode=TwoWay}"
                                      IsEnabled="{Binding IsEditing}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="1"
                                    Content="Manage"
                                    Command="{Binding ManageGroupsCommand}"
                                    CommandParameter="{Binding RelativeSource={RelativeSource Self}}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TabControl>
                    <TabControl.Styles>
                        <Style Selector="TabItem">
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="Padding" Value="10, 0" />
                        </Style>
                    </TabControl.Styles>
                    <TabItem Header="Connection">
                        <StackPanel Spacing="8" Margin="0,15,0,15">
                            <Grid RowDefinitions="Auto,Auto"
                                  ColumnDefinitions="3*,1*"
                                  ColumnSpacing="10"
                                  RowSpacing="8"
                                  IsVisible="{Binding IsServerConnectionSelected}">
                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Text="Server" />
                                <TextBox Grid.Row="1"
                                         Grid.Column="0"
                                         Text="{Binding SelectedConnection.Server, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsEditing}"
                                         IsReadOnly="{Binding !IsEditing}" />

                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           Text="Port"
                                           IsVisible="{Binding IsPortConnectionSelected}" />
                                <TextBox Grid.Row="1"
                                         Grid.Column="1"
                                         Text="{Binding SelectedConnection.Port, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsEditing}"
                                         IsReadOnly="{Binding !IsEditing}"
                                         IsVisible="{Binding IsPortConnectionSelected}" />
                            </Grid>

                            <TextBlock Text="{Binding DatabaseLabel}" />
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8"
                                  HorizontalAlignment="Stretch">
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding AvailableDatabaseNames}"
                                          Text="{Binding SelectedConnection.Database, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"
                                          HorizontalAlignment="Stretch"
                                          IsHitTestVisible="{Binding IsEditing}"
                                          Focusable="{Binding IsEditing}" />
                                <Button Grid.Column="1"
                                        Content="..."
                                        Command="{Binding RefreshDatabaseNamesCommand}"
                                        IsVisible="{Binding CanRefreshDatabaseNames}"
                                        IsEnabled="{Binding IsEditing}" />
                            </Grid>

                            <Grid RowDefinitions="Auto,Auto"
                                  ColumnDefinitions="*,*"
                                  IsVisible="{Binding UsesSqlServerAuthenticationMode}"
                                  ColumnSpacing="8"
                                  >
                                <TextBlock Grid.Column="0" Grid.Row="0" Text="Authentication" />
                                <ComboBox Grid.Column="0" Grid.Row="1"
                                          ItemsSource="{Binding SqlServerAuthenticationModes}"
                                          SelectedItem="{Binding SelectedSqlServerAuthenticationOption, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"
                                          IsEnabled="{Binding IsEditing}"
                                          >
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                                           Text="For LocalDB,&#10;use SQL Server with Windows Authentication&#10;and a server such as (localdb)\MSSQLLocalDB."
                                           FontSize="10.5"
                                           Foreground="DarkGoldenrod"
                                           TextWrapping="WrapWithOverflow"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Stretch"
                                           IsVisible="{Binding IsSqlServerConnectionSelected}" />
                            </Grid>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        IsVisible="{Binding IsSqLiteConnectionSelected}">
                                <Button Content="Select File"
                                        Command="{Binding SelectSqLiteFileCommand}" />
                                <Button Content="Create File"
                                        Command="{Binding CreateSqLiteFileCommand}" />
                            </StackPanel>

                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" ColumnSpacing="10" RowSpacing="8"
                                  IsVisible="{Binding UsesCredentialsForSelectedConnection}">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Username" />
                                <TextBox Grid.Row="1" Grid.Column="0"
                                         Text="{Binding SelectedConnection.User, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsEditing}"
                                         IsReadOnly="{Binding !IsEditing}"
                                />

                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Password" />
                                <TextBox Grid.Row="1" Grid.Column="1"
                                         Text="{Binding SelectedConnection.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Watermark="{Binding PasswordWatermark}"
                                         IsReadOnly="{Binding !IsEditing}"
                                         IsHitTestVisible="{Binding IsEditing}"
                                         Focusable="{Binding IsEditing}"
                                         PasswordChar="*" />
                            </Grid>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="Advanced">
                        <StackPanel Spacing="8" Margin="0,15,0,15">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="20"
                                  IsVisible="{Binding ShowsSecurityOptions}">
                                <CheckBox Grid.Column="0"
                                          Content="Encrypt connection"
                                          IsChecked="{Binding SelectedConnection.Encrypt, Mode=TwoWay}"
                                          IsEnabled="{Binding IsEditing}" />
                                <CheckBox Grid.Column="1"
                                          Content="Trust server certificate"
                                          IsChecked="{Binding SelectedConnection.TrustServerCertificate, Mode=TwoWay}"
                                          IsEnabled="{Binding IsEditing}" />
                            </Grid>

                            <TextBlock Text="Use 'Trust server certificate' only when the SQL Server certificate is not trusted on this machine."
                                       FontSize="11"
                                       Foreground="DarkGoldenrod"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding IsSqlServerConnectionSelected}" />

                            <TextBlock Text="For MySQL, use 'Encrypt connection' to require TLS. 'Trust server certificate' relaxes certificate validation."
                                       FontSize="11"
                                       Foreground="DarkGoldenrod"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding IsMySqlConnectionSelected}" />

                            <TextBlock Text="For PostgreSQL, use 'Encrypt connection' to enable SSL/TLS. 'Trust server certificate' skips certificate validation."
                                       FontSize="11"
                                       Foreground="DarkGoldenrod"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding IsPostgresConnectionSelected}" />

                            <TextBlock Text="For Oracle, enter the service name used by this connection."
                                       FontSize="11"
                                       Foreground="DarkGoldenrod"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding IsOracleConnectionSelected}" />

                            <TextBlock Text="SQLite connects directly to a local database file."
                                       FontSize="11"
                                       Foreground="DarkGoldenrod"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding IsSqLiteConnectionSelected}" />

                            <TextBlock Text="{Binding SecureStorageWarningMessage}"
                                       FontSize="11"
                                       Foreground="IndianRed"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding IsSecureStorageUnavailable}" />

                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="12"
                                  RowSpacing="8"
                                  RowDefinitions="Auto, Auto"
                                  >
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="DML transaction mode" />
                                <ComboBox Grid.Row="1" Grid.Column="0"
                                          HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding DmlTransactionModes}"
                                          SelectedItem="{Binding SelectedDmlTransactionModeOption, Mode=TwoWay}"
                                          IsEnabled="{Binding IsEditing}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Default statement timeout" />
                                <ComboBox Grid.Row="1" Grid.Column="1"
                                          HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding StatementTimeoutOptions}"
                                          SelectedItem="{Binding SelectedStatementTimeoutSeconds, Mode=TwoWay}"
                                          IsEnabled="{Binding IsEditing}" />
                            </Grid>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </StackPanel>
            

        </Grid>

    </DockPanel>
    
</UserControl>
