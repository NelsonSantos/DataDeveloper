<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DataDeveloper.ViewModels"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="480"
             x:Class="DataDeveloper.Views.ManageConnectionGroupsDialogView">
    <Design.DataContext>
        <vm:ManageConnectionGroupsViewModel />
    </Design.DataContext>

    <DockPanel Margin="16">

        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,16,0,0">
            <Button Grid.Column="0"
                    Content="Add group"
                    Classes="dialog-button"
                    Command="{Binding AddCommand}"
                    HorizontalAlignment="Left" />
            <Button Grid.Column="1"
                    Content="Close"
                    Classes="dialog-button primary"
                    Command="{Binding CloseCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                    HorizontalAlignment="Right" />
        </Grid>

        <ListBox ItemsSource="{Binding Groups}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ConnectionGroupRow}">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,4">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Group.Name}"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding !IsEditing}" />
                        <TextBox Grid.Column="0"
                                 Text="{Binding DraftName, Mode=TwoWay}"
                                 IsVisible="{Binding IsEditing}" />

                        <Button Grid.Column="1"
                                Background="Transparent"
                                ToolTip.Tip="Edit"
                                IsVisible="{Binding !IsEditing}"
                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}">
                            <TextBlock Text="&#xF03EB;" Classes="MaterialIcon" />
                        </Button>
                        <Button Grid.Column="1"
                                Background="Transparent"
                                ToolTip.Tip="Save"
                                IsVisible="{Binding IsEditing}"
                                Command="{Binding DataContext.ConfirmCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}">
                            <TextBlock Text="&#xF0193;" Classes="MaterialIcon" Foreground="LightGreen" />
                        </Button>

                        <Button Grid.Column="2"
                                Background="Transparent"
                                ToolTip.Tip="Delete"
                                IsVisible="{Binding !IsEditing}"
                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}">
                            <TextBlock Text="&#xF0A7A;" Classes="MaterialIcon" Foreground="Brown" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
