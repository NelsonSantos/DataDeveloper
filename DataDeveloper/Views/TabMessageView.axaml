<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:DataDeveloper.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="DataDeveloper.Views.TabMessageView"
             xmlns:vm="using:DataDeveloper.ViewModels"
             x:DataType="vm:TabMessageViewModel">
    <Design.DataContext>
        <viewModels:TabMessageViewModel />
    </Design.DataContext>
    <SelectableTextBlock Margin="4" Text="{Binding Message}"/>
</UserControl>
