<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DataDeveloper.Views"
        x:Class="DataDeveloper.Views.MainWindow"
        xmlns:vm="using:DataDeveloper.ViewModels"
        x:DataType="vm:MainWindowViewModel"
        Title="Data Developer"
        Width="1000" Height="700">
    <Window.KeyBindings>
        <KeyBinding Gesture="{Binding OpenFileGesture}" Command="{Binding OpenFileCommand}" />
        <KeyBinding Gesture="{Binding SaveGesture}" Command="{Binding SaveCurrentEditorTabCommand}" />
        <KeyBinding Gesture="{Binding SaveAsGesture}" Command="{Binding SaveAsCurrentEditorTabCommand}" />
        <KeyBinding Gesture="{Binding NewQueryTabGesture}" Command="{Binding NewQueryTabCommand}" />
    </Window.KeyBindings>
    <!-- macOS consumes Control-Tab before it reaches the app (it never arrives as a key press), so the switcher is
         opened through native menu items, like Safari's; elsewhere MainWindow handles the key itself. -->
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="Window">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Show Next Tab" Gesture="Ctrl+Tab" Click="OnShowNextQueryTab" />
                        <NativeMenuItem Header="Show Previous Tab" Gesture="Ctrl+Shift+Tab" Click="OnShowPreviousQueryTab" />
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>
        </NativeMenu>
    </NativeMenu.Menu>
    <views:MainView />
</Window>
